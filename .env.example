# ==========================================
# Virtual Velocity - Environment Configuration
# ==========================================

# Canonical origin of the production site (used in metadata, sitemaps, and robots)
NEXT_PUBLIC_SITE_URL=https://www.thevirtualvelocity.com

# Endpoint for client brief submissions. Defaults to the internal route '/api/contact'
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# Optional webhook for forwarding contact form inquiries (e.g. Slack, Discord, Zapier)
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional Supabase credentials for client reviews storage and moderation
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
